{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LookAtMyQuant Launcher",
  "version": "0.1.0",
  "identifier": "com.shreyas.lookatmyquant-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LookAtMyQuant Launcher",
        "width": 1000,
        "height": 740,
        "minWidth": 800,
        "minHeight": 580,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#1c1c1e",
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../sidecar/server.py": "sidecar/server.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
